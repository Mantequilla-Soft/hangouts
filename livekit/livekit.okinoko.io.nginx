server {
    listen 80;
    server_name livekit.okinoko.io;

    # Lets-Encrypt HTTP-01 challenges land here pre-TLS. After running
    # `certbot --nginx -d livekit.okinoko.io` certbot rewrites this to add the
    # 443 ssl block and redirect 80 → 443.

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;

        # WebSocket upgrade for LiveKit signaling (wss://livekit.okinoko.io)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket connections are long-lived
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # WHIP ingress — external encoders (OBS 30.2+, ffmpeg, etc) POST/PATCH
    # here to publish into a room. Proxied to the ingress container's
    # whip_port (see livekit/ingress.yaml on the VPS, not committed).
    # 8080 is a common default but may already be bound by something else on
    # the box (it was, in production — check with `ss -tln` before assuming
    # 8080 is free, and keep this in sync with whatever whip_port you pick).
    location /whip/ {
        proxy_pass http://127.0.0.1:8082/whip/;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
