LIVEKIT_HOST=https://livekit.yourproject.com
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
SESSION_SECRET=generate-a-random-64-char-string-here
HIVE_API_NODE=https://api.hive.blog

# Audio recording publish path (audio.3speak.tv → IPFS).
# Leave AUDIO_API_KEY empty to disable the legacy direct-IPFS upload route;
# new integrations use the SDK's onAudioHandoff callback instead.
AUDIO_API_URL=https://audio.3speak.tv
AUDIO_API_KEY=your_audio_api_key_here

# 3Speak embed-uploads service used by the recording → studio handoff and
# any embed-style asset uploads from the server. Defaults match production.
EMBED_UPLOAD_URL=https://embed.3speak.tv/uploads
EMBED_API_URL=https://embed.3speak.tv/api
EMBED_API_KEY=your_embed_api_key_here

# Long-form video upload service used by the /studio publish path
# (separate from shorts). Token is the bearer used by server-side
# uploads on the user's behalf.
VIDEO_UPLOAD_URL=https://video.3speak.tv
VIDEO_UPLOAD_TOKEN=your_video_upload_token_here

# 3Speak frontend base URL used to build studio share-links the server
# returns to clients (e.g. embed-studio handoff URLs).
STUDIO_FRONTEND_URL=https://3speak.tv

MONGODB_URI=mongodb://localhost:27017/your_3speak_db

# Boost (superchat) pipeline
# Set BOOSTS_ENABLED=true to enable listener + ingest endpoints.
BOOSTS_ENABLED=false
# Platform wallet that receives incoming boost transfers.
BOOST_PLATFORM_ACCOUNT=your_boost_wallet_account
# Active key for BOOST_PLATFORM_ACCOUNT. Keep this server-only and secret-managed.
BOOST_PLATFORM_ACTIVE_KEY=your_platform_active_key_here
# Platform fee percent retained from each accepted boost (e.g. 5 = 5%).
BOOST_PLATFORM_FEE_PERCENT=5
# HIVE/USD is pulled from CoinGecko and cached in-memory.
# If CoinGecko is unavailable, fallback is used.
BOOST_HIVE_USD_FALLBACK=0.25
BOOST_HIVE_USD_CACHE_MS=120000

PORT=3002

# 3Speak checker — live-stream leaderboard stats via /stream-stats/* (Bearer auth).
# Empty STREAM_STATS_SECRET disables reporting (must match the checker's value).
CHECKER_URL=https://checker.3speak.tv
STREAM_STATS_SECRET=

# HLS for large audiences. Leave it out to use the default: the first 50
# viewers of a stream watch over WebRTC, the rest over HLS (50 matches the
# 2026-11-05 stress test). N = the first N on WebRTC, 0 = every viewer on HLS,
# empty (HLS_VIEWER_THRESHOLD=) = HLS off.
# HLS_VIEWER_THRESHOLD=50
# Optional CDN pull zone in front of this API (origin = this API). Empty = served here.
HLS_PUBLIC_BASE=
# A viewer whose WebRTC connection stays poor for 15 s may switch to HLS.
HLS_WEAK_FALLBACK=true
# Video bitrate of the HLS rendition (kbps).
HLS_VIDEO_BITRATE=2000

# --- Everything else, with its default (see docs/integrator-guide.md#server-configuration) ---
# Egress pages (conference recordings; stream recordings/DVR/HLS fallback).
# EGRESS_TEMPLATE_URL=https://hangout.3speak.tv/egress-template
# EGRESS_STANDALONE_TEMPLATE_URL=https://3speak.tv/egress-stream
# Admin key for POST /boosts/ingest (manual reconciliation). Empty = route off.
BOOST_INGEST_KEY=
# WHIP: public URL of the ingress (studio OBS / phone sources), this API's own
# WHIP base (headless OBS templates) and the ingress handler on loopback.
# INGRESS_WHIP_URL=https://livekit.okinoko.io/w
# PUBLIC_WHIP_BASE=https://hangouts.okinoko.io/whip
# INGRESS_WHIP_INTERNAL_URL=http://127.0.0.1:8086/w
# Hive announcement for headless OBS streams.
# ANNOUNCE_API_URL=http://127.0.0.1:4021
OPENPODS_ANNOUNCE_SECRET=
# Streaming secrets (empty = derived from SESSION_SECRET).
STREAM_KEY_SECRET=
# Pro trial and the free daily stream limit.
# PRO_TESTING_ENABLED=true
# PRO_TESTING_HOURS=24
# STREAM_LIMIT_EXEMPT=account1,account2
# DVR, clips, highlights, podcast recording.
# DVR_ENABLED=true
# DVR_BUFFER_SEC=600
# CLIP_KEEP_HOURS=48
# CLIPS_DIR_MAX_MB=4096
# HIGHLIGHTS_ENABLED=true
# PODCAST_RECORDING_ENABLED=true
# Live captions (off by default).
# CAPTIONS_ENABLED=false
# CAPTIONS_MAX_STREAMS=3
# CAPTIONS_SLOT_TTL_SEC=90
# Read outside config.ts.
# MAX_GUESTS_PER_ROOM=50
# CHAT_BACKLOG_SIZE=300
# POINTS_START=1000
# RAID_COUNTDOWN_SEC=10
# RAID_COOLDOWN_MIN=10
